# RFP Shred environment — copy to .env and fill in. Placeholder values run
# the dev stack. Values are injected from the host file, never baked into
# images. app/core/config.py refuses a strict boot on missing names.

# Core
# APP_ENV: dev | prod | test. prod enables strict boot validation (refuses
# on missing/empty/short secrets per section 5/8); dev/test boot leniently.
APP_ENV=dev
APP_SECRET=dev-placeholder-secret-change-me-32bytes!
DATABASE_URL=postgresql://rfp:rfp@postgres:5432/rfp
FILES_DIR=./files
PUBLIC_URL=http://localhost:8080
# Hostname only (for example, rfp.example.com). The production Compose overlay
# requires this value; empty falls back to localhost in the development stack.
PUBLIC_HOST=
PORT=8080
WORKER_CONCURRENCY=1

# Model (MODEL_PROVIDER: mock | openai | anthropic — mock runs the dev stack
# with a deterministic local extractor, no API key needed)
MODEL_PROVIDER=mock
MODEL_NAME=mock-extractor-1
MODEL_MAX_TOKENS=8192
MODEL_INPUT_PRICE_PER_M=3.0
MODEL_OUTPUT_PRICE_PER_M=15.0
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PROVIDER_HEALTH_CRON=*/30 * * * *

# Money (dev only: leave STRIPE_SECRET empty for the stub checkout; strict
# production requires Stripe credentials and real price IDs)
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
PRICE_SINGLE=price_single_placeholder
PRICE_PLAN=price_plan_placeholder
MONTHLY_INFERENCE_CAP_USD=100

# Registry (dev only: SAM_API_KEY may be empty; the production stack starts
# the sweep scheduler and therefore requires a real key)
SAM_API_KEY=
SAM_MAX_RPS=2
SWEEP_CRON=0 6 * * *
MAX_SWEEP_MATCHES_PER_RUN=50

# Mail (dev only: leave SMTP_URL empty to write to FILES_DIR/outbox; strict
# production requires SMTP delivery)
SMTP_URL=
MAIL_FROM=rfp-shred@example.com

# Limits
MAX_UPLOAD_MB=60
MAX_ZIP_ENTRIES=500
QUALITY_CRON=0 3 * * 0
CLEANUP_CRON=0 3 * * *
